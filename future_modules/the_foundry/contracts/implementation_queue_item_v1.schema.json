{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Implementation Queue Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "queue_id",
    "idea_id",
    "queue_rank",
    "priority_band",
    "why_now",
    "required_resources",
    "expected_build_output",
    "owner",
    "operator_approval_state",
    "approval_notes",
    "target_module",
    "effort_estimate",
    "dependency_status",
    "source_confidence_snapshot",
    "success_criteria",
    "next_action",
    "status",
    "blockers",
    "created_at",
    "last_updated"
  ],
  "properties": {
    "queue_id": { "type": "string", "minLength": 1 },
    "idea_id": { "type": "string", "minLength": 1 },
    "queue_rank": { "type": "integer", "minimum": 1 },
    "priority_band": { "type": "string", "minLength": 1 },
    "why_now": { "type": "string", "minLength": 1 },
    "required_resources": { "type": "array", "items": { "type": "string" } },
    "expected_build_output": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "operator_approval_state": { "type": "string", "enum": ["pending", "approved", "rejected"] },
    "approval_notes": { "type": "string" },
    "target_module": { "type": "string", "minLength": 1 },
    "effort_estimate": { "type": "string", "minLength": 1 },
    "dependency_status": { "type": "string", "minLength": 1 },
    "source_confidence_snapshot": { "type": "number", "minimum": 0, "maximum": 5 },
    "success_criteria": { "type": "array", "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["proposed", "ready", "in_design", "in_build", "blocked", "done", "dropped"] },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "minLength": 1 },
    "last_updated": { "type": "string", "minLength": 1 }
  }
}
