{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Candidate Idea v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "source_id",
    "source_lane",
    "title",
    "summary",
    "category",
    "claim",
    "implementation_implication",
    "problem_solved",
    "proposed_pattern",
    "idea_kind",
    "confidence",
    "evidence_strength",
    "transferability",
    "expected_upside",
    "risk_reduction_value",
    "implementation_cost",
    "novelty",
    "dependency_burden",
    "needs_validation",
    "verification_gaps",
    "duplicate_group_key",
    "dedupe_confidence",
    "registry_match_id",
    "recommendation_state",
    "recommendation_reason",
    "extraction_method",
    "created_at"
  ],
  "properties": {
    "candidate_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "source_lane": { "type": "string", "enum": ["article", "github", "x_post"] },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1 },
    "implementation_implication": { "type": "string", "minLength": 1 },
    "problem_solved": { "type": "string", "minLength": 1 },
    "proposed_pattern": { "type": "string", "minLength": 1 },
    "idea_kind": {
      "type": "string",
      "enum": ["pattern", "workflow", "component", "control", "architecture", "research_method", "data_method", "tooling"]
    },
    "confidence": { "type": "integer", "minimum": 0, "maximum": 5 },
    "evidence_strength": { "type": "integer", "minimum": 0, "maximum": 5 },
    "transferability": { "type": "integer", "minimum": 0, "maximum": 5 },
    "expected_upside": { "type": "integer", "minimum": 0, "maximum": 5 },
    "risk_reduction_value": { "type": "integer", "minimum": 0, "maximum": 5 },
    "implementation_cost": { "type": "integer", "minimum": 0, "maximum": 5 },
    "novelty": { "type": "integer", "minimum": 0, "maximum": 5 },
    "dependency_burden": { "type": "integer", "minimum": 0, "maximum": 5 },
    "needs_validation": { "type": "boolean" },
    "verification_gaps": { "type": "array", "items": { "type": "string" } },
    "duplicate_group_key": { "type": "string", "minLength": 1 },
    "dedupe_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "registry_match_id": { "type": "string" },
    "recommendation_state": {
      "type": "string",
      "enum": ["discard", "watchlist", "research_next", "implement_soon", "queue_candidate"]
    },
    "recommendation_reason": { "type": "string" },
    "extraction_method": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 }
  }
}
