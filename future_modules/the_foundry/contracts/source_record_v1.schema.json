{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Source Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_type",
    "source_lane",
    "input_mode",
    "title",
    "raw_input_ref",
    "processed_output_ref",
    "source_url_or_locator",
    "source_hash",
    "ingestion_method",
    "source_timestamp",
    "created_at",
    "reviewer_model",
    "review_version",
    "extraction_version",
    "review_status",
    "extraction_status",
    "review_summary",
    "key_claims",
    "quality_flags",
    "processing_notes",
    "candidate_ids"
  ],
  "properties": {
    "source_id": { "type": "string", "minLength": 1 },
    "source_type": { "type": "string", "enum": ["article_text", "github_repo", "x_post_brief"] },
    "source_lane": { "type": "string", "enum": ["article", "github", "x_post"] },
    "input_mode": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "raw_input_ref": { "type": "string", "minLength": 1 },
    "processed_output_ref": { "type": "string", "minLength": 1 },
    "source_url_or_locator": { "type": "string", "minLength": 1 },
    "source_hash": { "type": "string", "minLength": 1 },
    "ingestion_method": { "type": "string", "minLength": 1 },
    "source_timestamp": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 1 },
    "reviewer_model": { "type": "string", "minLength": 1 },
    "review_version": { "type": "string", "minLength": 1 },
    "extraction_version": { "type": "string", "minLength": 1 },
    "review_status": { "type": "string", "enum": ["pending", "complete", "failed", "escalated"] },
    "extraction_status": { "type": "string", "enum": ["not_started", "complete", "failed", "escalated"] },
    "review_summary": { "type": "string" },
    "key_claims": { "type": "array", "items": { "type": "string" } },
    "quality_flags": { "type": "array", "items": { "type": "string" } },
    "processing_notes": { "type": "string" },
    "candidate_ids": { "type": "array", "items": { "type": "string" } }
  }
}
