{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "repo_deep_review_result.schema.json",
  "title": "Repo Deep Review Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo_url",
    "repo_name",
    "profile_used",
    "classification",
    "confidence",
    "repo_reality_score",
    "our_fit_score",
    "novelty_flag",
    "fatal_flags_triggered",
    "deep_review_summary",
    "key_evidence",
    "risk_assessment",
    "adoption_recommendation",
    "deeper_review_questions_resolved",
    "remaining_open_questions",
    "worker_status",
    "stop_condition",
    "escalation_triggered",
    "escalation_reasons",
    "final_disposition"
  ],
  "properties": {
    "repo_url": {
      "type": "string",
      "format": "uri"
    },
    "repo_name": {
      "type": "string",
      "minLength": 1
    },
    "profile_used": {
      "type": "string",
      "enum": [
        "generic_repo_triage",
        "workflow_tooling",
        "prediction_market_execution"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "materially_useful",
        "marginal",
        "too_fuzzy",
        "reject"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "repo_reality_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 50
    },
    "our_fit_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40
    },
    "novelty_flag": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "fatal_flags_triggered": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "deep_review_summary": {
      "type": "string",
      "minLength": 1
    },
    "key_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_assessment": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "adoption_recommendation": {
      "type": "string",
      "minLength": 1
    },
    "deeper_review_questions_resolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remaining_open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "worker_status": {
      "type": "string",
      "enum": [
        "deep_review_in_progress",
        "deep_review_complete",
        "escalated",
        "rejected"
      ]
    },
    "stop_condition": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "repo URL invalid or unreachable",
        "repo cannot be classified with available evidence",
        "repo appears unsafe to inspect further",
        "repo requires code execution to verify core claims",
        "repo scope exceeds bounded intake review"
      ]
    },
    "escalation_triggered": {
      "type": "boolean"
    },
    "escalation_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "novelty_flag high but fit unclear",
          "repo appears materially useful but classification confidence is low",
          "conflicting evidence between README/docs and code",
          "fatal flag triggered but repo still appears strategically interesting"
        ]
      },
      "uniqueItems": true
    },
    "final_disposition": {
      "type": "string",
      "enum": [
        "materially_useful",
        "marginal",
        "too_fuzzy",
        "reject"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "classification": {
            "const": "materially_useful"
          }
        }
      },
      "then": {
        "properties": {
          "repo_reality_score": {
            "minimum": 32
          },
          "our_fit_score": {
            "minimum": 24
          },
          "fatal_flags_triggered": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "marginal"
          }
        }
      },
      "then": {
        "properties": {
          "repo_reality_score": {
            "minimum": 24
          },
          "our_fit_score": {
            "minimum": 16
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "classification": {
              "const": "materially_useful"
            },
            "final_disposition": {
              "const": "materially_useful"
            }
          }
        },
        {
          "properties": {
            "classification": {
              "const": "marginal"
            },
            "final_disposition": {
              "const": "marginal"
            }
          }
        },
        {
          "properties": {
            "classification": {
              "const": "too_fuzzy"
            },
            "final_disposition": {
              "const": "too_fuzzy"
            }
          }
        },
        {
          "properties": {
            "classification": {
              "const": "reject"
            },
            "final_disposition": {
              "const": "reject"
            }
          }
        }
      ]
    }
  ]
}
